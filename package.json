{
  "name": "evening-chat",
  "version": "1.3.1",
  "packageManager": "pnpm@^9.9.0",
  "description": "A lightweight dialogue-only romance game for vivo WATCH GT 2 / BlueOS.",
  "private": true,
  "scripts": {
    "generate": "node tools/generate_story_data.js",
    "preview": "node tools/serve.js 8766",
    "lint": "eslint --ext .ux,.js src/",
    "prettier": "node ./scripts/selfCloseInputTag.js && prettier --plugin prettier-plugin-ux --write \"src/**/*.{js,ux,less,scss,css}\""
  },
  "dependencies": {
    "lz-string": "1.5.0",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.2.0",
    "eslint": "^7.32.0",
    "eslint-plugin-json": "^1.4.0",
    "eslint-plugin-vue": "^9.26.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "prettier-plugin-ux": "^0.3.0"
  },
  "keywords": [
    "blueos",
    "vivo-watch",
    "romance-game",
    "watch-app"
