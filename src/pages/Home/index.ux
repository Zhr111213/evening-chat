<script>
  import STORY from '../../data/story_meta.js'
  import SCENE_COMPRESSED from '../../data/scene_compressed.js'
  import LZString from '../../utils/lz-string.js'
  const persistentStorage = require('@blueos.storage.storage')

  const BACKGROUND = '你认识一个很在意的人，已经三个月。今晚一起加班后，你们在便利店门口遇到大雨。TA站在你旁边，手里只有一杯热咖啡。'
  const SAVE_KEY = 'evening_chat_save_v1'
  const SAVE_VERSION = 1
  const ACTION_BY_ID = {}
  const HOTEL_ACTION_BY_ID = {}
  let CURRENT_SCENE = null
  let HOTEL_DATA = null

  for (let i = 0; i < STORY.actions.length; i++) {
    ACTION_BY_ID[STORY.actions[i].id] = STORY.actions[i]
  }
  for (let i = 0; i < STORY.hotelActions.length; i++) {
    HOTEL_ACTION_BY_ID[STORY.hotelActions[i].id] = STORY.hotelActions[i]
  }

  const START_ACTIONS = ['a01', 'a02', 'a03']
  const NIGHT_START_HOME = ['a02', 'a04', 'a15']
  const NIGHT_START_CALL = ['a04', 'a12', 'a29']
  const NEXT_ACTIONS = {
    a01: ['a02', 'a03', 'a07'],
    a02: ['a04', 'a06', 'a12'],
    a03: ['a08', 'a09', 'a21'],
    a04: ['a05', 'a12', 'a16'],
    a05: ['a06', 'a10', 'a13'],
    a06: ['a08', 'a15', 'a21'],
    a07: ['a08', 'a11', 'a25'],
    a08: ['a11', 'a19', 'a13'],
    a09: ['a05', 'a17', 'a21'],
    a10: ['a05', 'a13', 'a17'],
    a11: ['a13', 'a19', 'a21'],
    a12: ['a04', 'a15', 'a16'],
    a13: ['a08', 'a19', 'a21'],
    a14: ['a08', 'a13', 'a21'],
    a15: ['a19', 'a25', 'a27'],
    a16: ['a19', 'a25', 'a27'],
    a17: ['a18', 'a23', 'a24'],
    a18: ['a17', 'a21', 'a13'],
    a19: ['a20', 'a25', 'a27'],
    a20: ['a11', 'a16', 'a25'],
    a21: ['a11', 'a18', 'a19'],
    a22: ['a23', 'a25', 'a26'],
    a23: ['a25', 'a29', 'a30'],
    a24: ['a28', 'a29', 'a30'],
    a25: ['a26', 'a27', 'a29'],
    a26: ['a19', 'a27', 'a30'],
    a27: ['a19', 'a25', 'a28'],
    a28: ['a27', 'a29', 'a30'],
    a29: ['a26', 'a28', 'a30'],
    a30: ['a27', 'a28', 'a29']
  }

  function randomLine(source) {
    const lines = Array.isArray(source) ? source : String(source).split('\n')
    return lines[Math.floor(Math.random() * lines.length)]
  }

  function sceneInfo(id) {
    for (let i = 0; i < STORY.scenes.length; i++) {
      if (STORY.scenes[i].id === id) return STORY.scenes[i]
    }
    return null
  }

  function decodeScene(id) {
    const data = SCENE_COMPRESSED[id]
    if (!data || !data.ambient || !data.transitions) return null
    const ambient = LZString.decompressFromEncodedURIComponent(data.ambient)
    const transitions = LZString.decompressFromEncodedURIComponent(data.transitions)
    if (!ambient || !transitions) return null
    const info = sceneInfo(id)
    return {
      id: id,
      name: info ? info.name : id,
      pools: data.pools || {},
      ambient: ambient,
      transitions: transitions,
      tones: data.tones || {}
    }
  }

  function decodeHotel() {
    const data = SCENE_COMPRESSED.hotel
    if (!data || !data.ambient) return null
    const ambient = LZString.decompressFromEncodedURIComponent(data.ambient)
    if (!ambient) return null
    return { pools: data.pools || {}, ambient: ambient }
  }

  function readSavedGame() {
    try {
      const raw = persistentStorage.getSync({ key: SAVE_KEY })
      if (!raw) return null
      const data = typeof raw === 'string' ? JSON.parse(raw) : raw
      if (!data || data.version !== SAVE_VERSION) return null
      return data
    } catch (error) {
      return null
    }
  }

  function writeSavedGame(data) {
    try {
      persistentStorage.set({
        key: SAVE_KEY,
        value: JSON.stringify(data)
      })
      return true
    } catch (error) {
      return false
    }
  }

  export default {
    data: {
      view: 'intro',
      background: BACKGROUND,
      characterName: '林知夏',
      avatarText: '夏',
      relationshipLabel: '恋爱中',
      affection: 60,
      stageName: '好感',
      band: 'high',
      avatarClass: 'avatar-high',
      dayStartAffection: 60,
      dayAffectionDelta: 0,
      lastActionId: '',
      sameActionCount: 0,
      usedToneKeys: [],
      stageChangeText: '',
      affectionSummary: '',
      day: 1,
      nextDay: 2,
      sceneId: '',
      sceneLabel: '',
      phase: 'main',
      round: 1,
      maxRounds: 10,
      counter: '1 / 10',
      transitionChance: 0.10,
      transitionsUsed: 0,
      nightKind: '',
      nightSourceId: '',
      nightLabel: '',
      currentAction: '',
      statusLine: '',
      chatRounds: [],
      scrollBottom: 0,
      actions: [],
      usedKeys: [],
      dayComplete: false,
      daySummary: '',
      loading: false,
      loadingText: '正在加载场景…',
      loadError: false,
      pendingDay: 1,
      pendingPhase: 'day',
      hasSave: false,
      saveSummary: '',
      introClass: 'intro'
    },

    onInit() {
      this.view = 'intro'
      this.refreshSaveState()
    },

    openModes() {
      this.view = 'modes'
    },

    backIntro() {
      this.view = 'intro'
    },

    openTargets() {
      this.view = 'targets'
    },

    backModes() {
      this.view = 'modes'
    },

    refreshSaveState() {
      const save = readSavedGame()
      this.hasSave = !!save
      if (!save) {
        this.saveSummary = ''
        this.introClass = 'intro'
        return
      }
      const place = save.phase === 'night'
        ? (save.nightLabel || '夜晚')
        : (save.sceneLabel || '')
      this.saveSummary = '第' + (save.day || 1) + '天 · ' + place + ' · ' + (save.stageName || '普通')
      this.introClass = 'intro intro-has-save'
    },

    saveGame() {
      if (this.loading || this.loadError || this.dayComplete && !this.daySummary) return
      const snapshot = {
        version: SAVE_VERSION,
        savedAt: Date.now(),
        characterName: this.characterName,
        avatarText: this.avatarText,
        relationshipLabel: this.relationshipLabel,
        day: this.day,
        nextDay: this.nextDay,
        sceneId: this.sceneId,
        sceneLabel: this.sceneLabel,
        phase: this.phase,
        round: this.round,
        maxRounds: this.maxRounds,
        counter: this.counter,
        transitionChance: this.transitionChance,
        transitionsUsed: this.transitionsUsed,
        nightKind: this.nightKind,
        nightSourceId: this.nightSourceId,
        nightLabel: this.nightLabel,
        currentAction: this.currentAction,
        chatRounds: this.chatRounds,
        usedKeys: this.usedKeys,
        usedToneKeys: this.usedToneKeys,
        dayComplete: this.dayComplete,
        daySummary: this.daySummary,
        affectionSummary: this.affectionSummary,
        affection: this.affection,
        stageName: this.stageName,
        band: this.band,
        avatarClass: this.avatarClass,
        dayStartAffection: this.dayStartAffection,
        dayAffectionDelta: this.dayAffectionDelta,
        lastActionId: this.lastActionId,
        sameActionCount: this.sameActionCount,
        stageChangeText: this.stageChangeText
      }
      if (writeSavedGame(snapshot)) {
        this.hasSave = true
        this.saveSummary = '第' + this.day + '天 · ' +
          (this.phase === 'night' ? (this.nightLabel || '夜晚') : this.sceneLabel) +
          ' · ' + this.stageName
      }
    },

    continueGame() {
      if (this.loading) return
      const save = readSavedGame()
      if (!save) {
        this.refreshSaveState()
        return
      }

      this.loading = true
      this.loadingText = '正在恢复存档…'
      this.loadError = false
      this.pendingPhase = 'continue'
      this.view = 'chat'
      this.statusLine = '正在恢复存档…'
      this.actions = []

      let scene = null
      try {
        if (save.phase === 'night' && save.nightSourceId === 'hotel') {
          HOTEL_DATA = decodeHotel()
          if (!HOTEL_DATA) throw new Error('Hotel data missing')
          scene = decodeScene('home')
        } else if (save.phase === 'night') {
          HOTEL_DATA = null
          scene = decodeScene('home')
          if (!scene) throw new Error('Home data missing')
        } else {
          HOTEL_DATA = null
          scene = decodeScene(save.sceneId)
          if (!scene) throw new Error('Scene data missing')
        }

        CURRENT_SCENE = scene
        this.characterName = save.characterName || '林知夏'
        this.avatarText = save.avatarText || this.characterName.slice(0, 1)
        this.relationshipLabel = save.relationshipLabel || '恋爱中'
        this.day = save.day || 1
        this.nextDay = save.nextDay || this.day + 1
        this.sceneId = save.sceneId || (scene ? scene.id : '')
        this.sceneLabel = save.sceneLabel || (scene ? scene.name : '')
        this.phase = save.phase || 'main'
        this.round = save.round || 1
        this.maxRounds = save.maxRounds || 10
        this.counter = save.counter || (this.round + ' / 10')
        this.transitionChance = typeof save.transitionChance === 'number' ? save.transitionChance : 0.10
        this.transitionsUsed = save.transitionsUsed || 0
        this.nightKind = save.nightKind || ''
        this.nightSourceId = save.nightSourceId || ''
        this.nightLabel = save.nightLabel || ''
        this.currentAction = save.currentAction || ''
        this.chatRounds = Array.isArray(save.chatRounds) ? save.chatRounds : []
        this.usedKeys = Array.isArray(save.usedKeys) ? save.usedKeys : []
        this.usedToneKeys = Array.isArray(save.usedToneKeys) ? save.usedToneKeys : []
        this.dayComplete = !!save.dayComplete
        this.daySummary = save.daySummary || ''
        this.affectionSummary = save.affectionSummary || ''
        this.affection = typeof save.affection === 'number' ? save.affection : 60
        this.stageName = save.stageName || '普通'
        this.band = save.band || 'low'
        this.avatarClass = save.avatarClass || 'avatar-low'
        this.dayStartAffection = typeof save.dayStartAffection === 'number'
          ? save.dayStartAffection
          : this.affection
        this.dayAffectionDelta = typeof save.dayAffectionDelta === 'number'
          ? save.dayAffectionDelta
          : 0
        this.lastActionId = save.lastActionId || ''
        this.sameActionCount = save.sameActionCount || 0
        this.stageChangeText = save.stageChangeText || ''
        this.loading = false
        this.loadError = false
        this.updateAffectionDisplay()
        this.actions = []
        if (!this.dayComplete) this.buildActions()
        this.scrollBottom = 1
        const self = this
        setTimeout(function () {
          self.scrollBottom = 0
        }, 30)
      } catch (error) {
        this.loading = true
        this.loadError = true
        this.loadingText = '存档恢复失败'
      }
    },

    startRomance() {
      this.characterName = '林知夏'
      this.avatarText = '夏'
      this.relationshipLabel = '恋爱中'
      this.setStartingAffection('林知夏')
      this.startDay(1)
    },

    startChase(name) {
      this.characterName = name
      this.avatarText = name.slice(0, 1)
      this.relationshipLabel = '正在追求'
      this.setStartingAffection(name)
      this.startDay(1)
    },

    setStartingAffection(name) {
      const affectionConfig = STORY.affection || {}
      const starts = affectionConfig.start || {}
      this.affection = typeof starts[name] === 'number' ? starts[name] : 40
      this.dayStartAffection = this.affection
      this.dayAffectionDelta = 0
      this.lastActionId = ''
      this.sameActionCount = 0
      this.usedToneKeys = []
      this.stageChangeText = ''
      this.affectionSummary = ''
      this.updateAffectionDisplay()
    },

    startDay(dayNumber) {
      if (this.loading && !this.loadError) return
      const target = STORY.scenes[Math.floor(Math.random() * STORY.scenes.length)]
      this.view = 'chat'
      this.loading = true
      this.loadingText = '正在加载场景…'
      this.loadError = false
      this.pendingDay = dayNumber
      this.pendingPhase = 'day'
      this.statusLine = '正在加载场景…'
      this.actions = []

      try {
        const scene = decodeScene(target.id)
        if (!scene) throw new Error('Missing scene: ' + target.id)
        this.applyDay(dayNumber, scene)
      } catch (error) {
        this.loading = true
        this.loadError = true
        this.loadingText = '场景加载失败'
      }
    },

    applyDay(dayNumber, scene) {
      CURRENT_SCENE = scene
      this.day = dayNumber
      this.nextDay = dayNumber + 1
      this.sceneId = scene.id
      this.sceneLabel = scene.name
      this.phase = 'main'
      this.round = 1
      this.maxRounds = 10
      this.counter = '1 / 10'
      this.transitionChance = 0.10
      this.transitionsUsed = 0
      this.nightKind = ''
      this.nightSourceId = ''
      this.nightLabel = ''
      this.currentAction = ''
      this.chatRounds = []
      this.scrollBottom = 0
      this.dayStartAffection = this.affection
      this.dayAffectionDelta = 0
      this.lastActionId = ''
      this.sameActionCount = 0
      this.usedToneKeys = []
      this.stageChangeText = ''
      this.affectionSummary = ''
      this.updateAffectionDisplay()
      this.addRound('', randomLine(scene.ambient), '', '', '')
      this.usedKeys = []
      this.dayComplete = false
      this.daySummary = ''
      this.loading = false
      this.loadError = false
      this.view = 'chat'
      this.buildActions()
      this.saveGame()
    },

    buildActions() {
      if (this.dayComplete || this.loading) return
      const ids = this.actionIdsForRound()
      const keys = ['A', 'B', 'C']
      this.actions = ids.map(function (id, index) {
        const action = this.phase === 'night' && this.nightKind === 'hotel'
          ? HOTEL_ACTION_BY_ID[id]
          : ACTION_BY_ID[id]
        return {
          key: keys[index],
          id: id,
          label: action ? action.label : id,
          tag: this.phase === 'night' ? '夜间' : '第' + this.round + '轮'
        }
      }, this)
    },

    updateAffectionDisplay() {
      const config = STORY.affection || {}
      const stages = config.stages || []
      const bands = config.bands || []
      let stage = stages[0] || { name: '普通' }
      for (let i = 0; i < stages.length; i++) {
        if (this.affection >= stages[i].min) stage = stages[i]
      }
      let band = bands[0] || { id: 'low' }
      for (let i = 0; i < bands.length; i++) {
        if (this.affection >= bands[i].min && this.affection <= bands[i].max) band = bands[i]
      }
      this.stageName = stage.name
      this.band = band.id
      this.avatarClass = band.id === 'high'
        ? 'avatar-high'
        : band.id === 'low' ? 'avatar-low' : 'avatar-cold'
      this.updateStatusLine()
    },

    updateStatusLine() {
      const stage = this.stageName || ''
      if (this.phase === 'night') {
        this.statusLine = '第' + this.day + '天 · ' + (this.nightLabel || '夜晚') + ' · ' + stage
      } else {
        this.statusLine = '第' + this.day + '天 · ' + (this.sceneLabel || '') + ' · ' + stage
      }
    },

    applyAffection(actionId) {
      const config = STORY.affection || {}
      const rules = config.actionDeltas || {}
      const rule = rules[actionId]
      if (!rule) {
        return { delta: 0, stageChanged: false, fromStage: this.stageName, toStage: this.stageName }
      }

      let delta = typeof rule.min === 'number' && this.affection < rule.min
        ? rule.low
        : rule.delta
      if (this.lastActionId === actionId) {
        this.sameActionCount = this.sameActionCount + 1
      } else {
        this.lastActionId = actionId
        this.sameActionCount = 1
      }
      if (delta > 0 && this.sameActionCount === 2) {
        const second = config.diminishing ? config.diminishing.second : 0.5
        delta = Math.floor(delta * second)
      } else if (delta > 0 && this.sameActionCount >= 3) {
        delta = config.diminishing ? config.diminishing.third : 0
      }

      const before = this.affection
      const fromStage = this.stageName
      this.affection = Math.max(0, Math.min(100, this.affection + delta))
      const actual = this.affection - before
      this.dayAffectionDelta = this.dayAffectionDelta + actual
      this.updateAffectionDisplay()
      const stageChanged = fromStage !== this.stageName
      if (stageChanged) {
        this.stageChangeText = '关系阶段：' + fromStage + ' → ' + this.stageName + '。'
      }
      return {
        delta: actual,
        stageChanged: stageChanged,
        fromStage: fromStage,
        toStage: this.stageName
      }
    },

    pickTone(actionId) {
      if (this.phase !== 'main') return ''
      const band = this.band
      let poolSource = null
      let keyPrefix = ''
      const reactions = SCENE_COMPRESSED.reactions || {}
      if (reactions[actionId] && reactions[actionId][band]) {
        poolSource = reactions[actionId][band]
        keyPrefix = 'reaction:' + actionId + ':' + band
      } else if (CURRENT_SCENE && CURRENT_SCENE.tones && CURRENT_SCENE.tones[band]) {
        poolSource = CURRENT_SCENE.tones[band]
        keyPrefix = 'tone:' + this.sceneId + ':' + band
      }
      if (!poolSource) return ''
      const chunks = Array.isArray(poolSource) ? poolSource : [poolSource]
      const chunkIndex = Math.floor(Math.random() * chunks.length)
      const text = LZString.decompressFromEncodedURIComponent(chunks[chunkIndex])
      if (!text) return ''
      const lines = String(text).split('\n')
      const start = Math.floor(Math.random() * lines.length)
      let selected = start
      for (let i = 0; i < lines.length; i++) {
        const candidate = (start + i) % lines.length
        const key = keyPrefix + ':' + chunkIndex + ':' + candidate
        if (this.usedToneKeys.indexOf(key) < 0) {
          selected = candidate
          this.usedToneKeys.push(key)
          break
        }
      }
      return lines[selected]
    },

    buildAffectionSummary() {
      const delta = this.dayAffectionDelta
      let text
      if (delta >= 5) text = '今天她明显更愿意靠近你了。'
      else if (delta > 0) text = '今天你们之间的距离近了一点。'
      else if (delta === 0) text = '今天的关系没有什么变化。'
      else if (delta >= -4) text = '她好像还有一点在意刚才的事。'
      else text = '她今天有些疏远你。'
      return this.stageChangeText
        ? this.stageChangeText + ' ' + text
        : text
    },

    actionIdsForRound() {
      if (this.phase === 'night') {
        if (this.nightKind === 'hotel') {
          const start = (this.round - 1) * 3
          return STORY.hotelActions.slice(start, start + 3).map(function (item) { return item.id })
        }
        if (this.round === 1) {
          return this.nightKind === 'call' ? NIGHT_START_CALL : NIGHT_START_HOME
        }
        return NEXT_ACTIONS[this.currentAction] || NIGHT_START_HOME
      }
      if (this.round === 1) return START_ACTIONS
      return NEXT_ACTIONS[this.currentAction] || START_ACTIONS
    },

    chooseAction(index) {
      if (this.loading) return
      const picked = this.actions[index]
      if (!picked || this.dayComplete) return

      this.currentAction = picked.id
      const response = this.pickLine(picked.id)

      if (this.phase === 'main') {
        this.applyAffection(picked.id)
        const tone = this.pickTone(picked.id)
        if (this.round >= 10) {
          this.addRound(picked.label, response, '', tone, this.band)
          this.startNight()
          return
        }
        this.advanceMainRound(picked.label, response, tone)
        return
      }

      this.addRound(picked.label, response, '', '', '')
      if (this.round >= 10) {
        this.finishNight()
        return
      }
      this.round = this.round + 1
      this.counter = this.round + ' / 10'
      this.buildActions()
      this.saveGame()
    },

    advanceMainRound(label, response, tone) {
      const target = this.pickTransitionTarget()
      if (!target) {
        this.finishMainRound(label, response, '', tone)
        return
      }

      const self = this
      this.loading = true
      this.loadingText = '正在前往' + target.name + '…'
      this.actions = []

      let scene = null
      try {
        scene = decodeScene(target.id)
      } catch (error) {
        scene = null
      }
      if (!scene) {
        self.finishMainRound(label, response, '', tone)
        return
      }

      CURRENT_SCENE = scene
      self.sceneId = scene.id
      self.sceneLabel = scene.name
      self.transitionsUsed = self.transitionsUsed + 1
      self.transitionChance = Math.max(
        STORY.balance.minTransitionChance,
        self.transitionChance - STORY.balance.transitionStep
      )
      self.updateAffectionDisplay()
      self.finishMainRound(label, response, randomLine(scene.transitions), tone)
    },

    finishMainRound(label, response, transition, tone) {
      this.loading = false
      this.addRound(label, response, transition, tone, this.band)
      this.round = this.round + 1
      this.counter = this.round + ' / 10'
      this.buildActions()
      this.saveGame()
    },

    pickTransitionTarget() {
      if (this.transitionChance <= 0) return null
      if (Math.random() >= this.transitionChance) return null
      const currentId = this.sceneId
      const candidates = STORY.scenes.filter(function (scene) {
        return scene.id !== currentId
      })
      if (!candidates.length) return null
      return candidates[Math.floor(Math.random() * candidates.length)]
    },

    pickLine(actionId) {
      let sourceId = this.sceneId
      if (this.phase === 'night') sourceId = this.nightSourceId

      let pool
      if (sourceId === 'hotel') {
        pool = HOTEL_DATA ? HOTEL_DATA.pools[actionId] : ''
      } else {
        pool = CURRENT_SCENE ? CURRENT_SCENE.pools[actionId] : ''
      }
      if (!pool && CURRENT_SCENE) pool = CURRENT_SCENE.pools[actionId]
      if (!pool) return ''

      const text = LZString.decompressFromEncodedURIComponent(pool)
      if (!text) return ''
      const lines = String(text).split('\n')
      const start = Math.floor(Math.random() * lines.length)
      let selected = start
      for (let i = 0; i < lines.length; i++) {
        const candidate = (start + i) % lines.length
        const key = sourceId + ':' + actionId + ':' + candidate
        if (this.usedKeys.indexOf(key) < 0) {
          selected = candidate
          this.usedKeys.push(key)
          break
        }
      }
      return lines[selected]
    },

    startNight(excludedIds, notice) {
      const self = this
      const excluded = excludedIds || []
      this.loading = true
      this.loadingText = '正在准备夜晚…'
      this.loadError = false
      this.pendingPhase = 'night'
      this.actions = []

      const available = STORY.night.outcomes.filter(function (item) {
        return excluded.indexOf(item.id) < 0
      })
      let total = 0
      for (let i = 0; i < available.length; i++) total += available[i].weight
      let cursor = Math.random() * total
      let outcome = available[available.length - 1]
      for (let i = 0; i < available.length; i++) {
        cursor -= available[i].weight
        if (cursor <= 0) {
          outcome = available[i]
          break
        }
      }

      const outcomeLine = randomLine(outcome.lines)

      if (outcome.id === 'parent') {
        this.loading = false
        this.phase = 'main'
        this.addRound('', outcomeLine, '', '', '')
        this.dayComplete = true
        this.daySummary = '家长要求你回家 · 今天结束'
        this.affectionSummary = this.buildAffectionSummary()
        this.actions = []
        this.saveGame()
        return
      }

      if (outcome.id === 'your_empty' && Math.random() < 0.4) {
        const rejection = randomLine(outcome.rejectionLines)
        this.startNight(['your_empty'], rejection)
        return
      }

      const useHotel = outcome.id === 'hotel'
      this.loadingText = useHotel ? '正在准备酒店…' : '正在准备夜晚…'

      function enterNight(data) {
        if (useHotel) HOTEL_DATA = data
        else CURRENT_SCENE = data

        self.phase = 'night'
        self.round = 1
        self.maxRounds = 10
        self.counter = '1 / 10'
        self.usedKeys = []
        self.currentAction = ''
        self.dayComplete = false
        self.daySummary = ''
        self.affectionSummary = ''
        self.loading = false
        self.loadError = false

        if (useHotel) {
          self.nightKind = 'hotel'
          self.nightSourceId = 'hotel'
          self.nightLabel = '酒店'
        } else if (outcome.id === 'her_home') {
          self.nightKind = 'call'
          self.nightSourceId = 'home'
          self.nightLabel = '电话陪伴'
        } else {
          self.nightKind = 'home'
          self.nightSourceId = 'home'
          self.nightLabel = outcome.id === 'her_empty' ? '她的家' : '你的家'
        }

        self.updateAffectionDisplay()
        self.addRound('', outcomeLine, notice || '', '', '')
        self.buildActions()
        self.saveGame()
      }

      function failNight() {
        self.loading = true
        self.loadError = true
        self.loadingText = '夜晚加载失败'
      }

      let nightData = null
      try {
        nightData = useHotel ? decodeHotel() : decodeScene('home')
      } catch (error) {
        nightData = null
      }
      if (nightData) enterNight(nightData)
      else failNight()
    },

    retryLoad() {
      if (!this.loadError) return
      this.loadError = false
      if (this.pendingPhase === 'continue') this.continueGame()
      else if (this.pendingPhase === 'night') this.startNight()
      else this.startDay(this.pendingDay || this.day)
    },

    addRound(you, her, note, tone, toneBand) {
      const next = this.chatRounds.slice()
      next.push({
        you: you || '',
        her: her || '',
        note: note || '',
        tone: tone || '',
        toneClass: tone ? 'tone-' + (toneBand || this.band) : ''
      })
      if (next.length > 10) next.shift()
      this.chatRounds = next
      // 先触发一次 scroll-bottom 更新，等新气泡完成布局后再贴到最底部。
      this.scrollBottom = 1
      const self = this
      setTimeout(function () {
        self.scrollBottom = 0
      }, 30)
    },

    finishNight() {
      this.loading = false
      this.dayComplete = true
      this.daySummary = '她太困了，说着说着睡着了 · 夜间结束'
      this.affectionSummary = this.buildAffectionSummary()
      this.counter = '10 / 10'
      this.actions = []
      this.saveGame()
    },

    nextDay() {
      this.startDay(this.day + 1)
    }
  }
</script>
