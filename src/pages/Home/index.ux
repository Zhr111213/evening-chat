<template>
  <div class="app">
    <div class="safe">
      <block if="{{view === 'intro'}}">
        <div class="intro">
          <div class="intro-head">
            <div class="brand-mark">
              <text class="brand-heart">♡</text>
            </div>
            <text class="eyebrow">LATE NIGHT TALK</text>
          </div>

          <text class="title">晚风对话</text>
          <text class="subtitle">选什么，就聊什么</text>

          <div class="background-card">
            <text class="background-label">背景</text>
            <text class="background-text">{{background}}</text>
          </div>

          <div class="intro-space"></div>

          <div class="primary-button" onclick="openModes">
            <text class="primary-title">进入游戏</text>
            <text class="primary-sub">选择今晚的关系</text>
          </div>
          <text class="intro-foot">52,150 句固定文本 · 每天自动随机场景</text>
        </div>
      </block>

      <block elif="{{view === 'modes'}}">
        <div class="mode">
          <text class="mode-eyebrow">CHOOSE YOUR STORY</text>
          <text class="mode-title">今晚，想怎么开始？</text>
          <text class="mode-sub">两种入口，每天自动进入一个随机场景。</text>

          <div class="mode-card romance-card" onclick="startRomance">
            <div class="mode-card-top">
              <text class="mode-tag">直接恋爱</text>
              <text class="mode-arrow">›</text>
            </div>
            <text class="mode-card-title">和知夏继续</text>
            <text class="mode-card-sub">默认对象：林知夏 · 已经恋爱</text>
          </div>

          <div class="mode-card chase-card" onclick="openTargets">
            <div class="mode-card-top">
              <text class="mode-tag chase-tag">追求他人</text>
              <text class="mode-arrow">›</text>
            </div>
            <text class="mode-card-title">换一个人，从头靠近</text>
            <text class="mode-card-sub">从三位角色中选择 · 进入追求状态</text>
          </div>

          <div class="mode-back" onclick="backIntro">
            <text class="mode-back-text">返回背景</text>
          </div>
        </div>
      </block>

      <block elif="{{view === 'targets'}}">
        <div class="mode">
          <text class="mode-eyebrow">PURSUE SOMEONE</text>
          <text class="mode-title">你想追求谁？</text>
          <text class="mode-sub">从三位中选择一位，今晚开始靠近。</text>

          <div class="target-option" onclick="startChase('苏遥')">
            <div class="target-avatar target-avatar-a">
              <text class="target-avatar-text">苏</text>
            </div>
            <div class="target-copy">
              <text class="target-name">苏遥</text>
              <text class="target-desc">安静慢热，喜欢雨天</text>
            </div>
          </div>

          <div class="target-option" onclick="startChase('江晚')">
            <div class="target-avatar target-avatar-b">
              <text class="target-avatar-text">江</text>
            </div>
            <div class="target-copy">
              <text class="target-name">江晚</text>
              <text class="target-desc">直率爱笑，说话不绕弯</text>
            </div>
          </div>

          <div class="target-option" onclick="startChase('顾晴')">
            <div class="target-avatar target-avatar-c">
              <text class="target-avatar-text">顾</text>
            </div>
            <div class="target-copy">
              <text class="target-name">顾晴</text>
              <text class="target-desc">温柔细心，总先照顾别人</text>
            </div>
          </div>

          <div class="intro-space"></div>
          <div class="mode-back" onclick="backModes">
            <text class="mode-back-text">返回模式选择</text>
          </div>
        </div>
      </block>

      <block elif="{{view === 'chat'}}">
        <div class="chat">
          <div class="chat-head">
            <div class="avatar">
              <text class="avatar-text">{{avatarText}}</text>
            </div>
            <div class="identity">
              <text class="name">{{characterName}}</text>
              <text class="state">{{statusLine}}</text>
            </div>
            <text class="counter">{{counter}}</text>
          </div>

          <scroll class="chat-log" scroll-y="true" scroll-bottom="{{scrollBottom}}">
            <div class="message-list">
              <div class="message-round" for="{{(i, round) in chatRounds}}">
                <block if="{{round.you}}">
                  <div class="you-row">
                    <div class="you-bubble">
                      <text class="you-text">{{round.you}}</text>
                    </div>
                  </div>
                </block>
                <div class="her-row">
                  <div class="her-bubble">
                    <text class="her-text">{{round.her}}</text>
                    <text class="transition-text" if="{{round.note}}">{{round.note}}</text>
                  </div>
                </div>
              </div>
            </div>
          </scroll>

          <block if="{{loading}}">
            <div class="loading-card">
              <text class="loading-title">{{loadingText}}</text>
              <text class="loading-sub" if="{{loadError}}">网络正常时可点按下方重试</text>
            </div>
            <div class="primary-button compact" if="{{loadError}}" onclick="retryLoad">
              <text class="primary-title">重试</text>
            </div>
          </block>

          <block elif="{{dayComplete}}">
            <div class="day-complete">
              <text class="day-complete-title">{{daySummary}}</text>
              <div class="primary-button compact" onclick="nextDay">
                <text class="primary-title">进入第 {{nextDay}} 天</text>
                <text class="primary-sub">重新随机场景，切换概率重置</text>
              </div>
            </div>
          </block>

          <block elif="{{!dayComplete}}">
            <div class="action-list">
              <div class="action-choice" for="{{(i, item) in actions}}" onclick="chooseAction(i)">
                <div class="action-key">
                  <text class="action-key-text">{{item.key}}</text>
                </div>
                <div class="action-copy">
                  <text class="action-tag">{{item.tag}}</text>
                  <text class="action-text">{{item.label}}</text>
                </div>
              </div>
            </div>
          </block>
        </div>
      </block>
    </div>
  </div>
</template>

